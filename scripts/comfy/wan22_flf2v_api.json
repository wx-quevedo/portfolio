  },
  "14": {
    "class_type": "KSamplerAdvanced",
    "_meta": { "title": "High noise (steps 0-2)" },
    "inputs": {
      "model": ["5", 0],
      "add_noise": "enable",
      "noise_seed": 20261018,
      "steps": 4,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["13", 0],
      "negative": ["13", 1],
      "latent_image": ["13", 2],
      "start_at_step": 0,
      "end_at_step": 2,
      "return_with_leftover_noise": "enable"
