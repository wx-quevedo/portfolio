---
// "Ask me anything": opens the single floating chat (AskChat.astro); no second iframe.
import { ui, ASK_ORIGIN, type Lang } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
---

<section id="ask" class="scene section" data-scene="ask" tabindex="-1" aria-labelledby="ask-title">
  <div class="container grid">
    <h2 id="ask-title" class="section-title">{t.ask.title}</h2>
    <div class="text">
      <p class="lede">{t.ask.text}</p>
      <div class="actions">
        <button type="button" class="btn btn-accent" data-ask-open aria-haspopup="dialog" aria-expanded="false" aria-controls="ask-panel">
          {t.ask.openChat}
        </button>
        <a class="link-arrow" href={`${ASK_ORIGIN}/?lang=${lang}`} target="_blank" rel="noopener">
          {t.ask.open}
          <Icon name="arrow-up-right" />
        </a>
      </div>
      <p class="mono muted">{t.ask.disclaimer}</p>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 32px;
    align-items: end;
  }
  .text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
  }
  .actions .link-arrow {
    min-height: 44px;
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 64px;
    }
  }
</style>
