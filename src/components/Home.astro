---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Stats from './Stats.astro';
import Story from './Story.astro';
import Work from './Work.astro';
import Detector from './Detector.astro';
import Xr from './Xr.astro';
import Research from './Research.astro';
import Ask from './Ask.astro';
import Contact from './Contact.astro';
import AskChat from './AskChat.astro';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<Base lang={lang}>
  <Header lang={lang} />
  <main id="main" tabindex="-1">
    <div id="top" class="scene hero-scene" data-scene="hero" tabindex="-1">
      <Hero lang={lang} />
      <Stats lang={lang} />
    </div>
    <Story lang={lang} />
    <Work lang={lang} />
    <Detector lang={lang} />
    <Xr lang={lang} />
    <Research lang={lang} />
    <Ask lang={lang} />
  </main>
  <Contact lang={lang} />
  <AskChat lang={lang} />
</Base>

<script>
  // Scene navigation only when html.scenes was set (no reduced motion); see Base.astro.
  if (document.documentElement.classList.contains('scenes')) {
    import('../scripts/scenes').then((m) => m.initScenes());
  }
</script>

<style>
  main:focus {
    outline: none;
  }
  :global(html.scenes) .hero-scene {
    justify-content: space-between;
    padding-bottom: 0;
  }
</style>
