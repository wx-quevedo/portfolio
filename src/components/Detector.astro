---
// "Try the detector" (P9c): the Buscapez tuna model running in the visitor's browser.
// Nothing heavy loads until "Try it": then src/scripts/detector-demo.ts starts a Web Worker
// (src/scripts/detector.worker.ts) that downloads onnxruntime-web and the ONNX model with progress.
import { ui, type Lang } from '../i18n/ui';
import MediaSlot from './MediaSlot.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const examples = [
  { file: 'albacore', species: 0 },
  { file: 'bigeye', species: 1 },
  { file: 'bonito-pair', species: 2 },
  { file: 'yellowfin', species: 3 },
  { file: 'yellowfin-portrait', species: 3 },
];
const DATASET_URL = 'https://universe.roboflow.com/washington-x-quevedo/tuna-fish-detection-0gaol';
const LICENSE_URL = 'https://creativecommons.org/licenses/by/4.0/';
const [creditBefore, creditRest] = t.detector.credit.split('{dataset}');
const [creditMiddle, creditAfter] = creditRest.split('{license}');
---

<section id="detector" class="scene detector section" data-scene="detector" tabindex="-1" aria-labelledby="detector-title">
  <div class="container grid">
    <div class="text">
      <h2 id="detector-title" class="section-title">{t.detector.title}</h2>
      <p class="lede">{t.detector.text}</p>
      <p class="mono privacy">{t.detector.privacy}</p>
      <p class="mono muted credit">
        {creditBefore}<a href={DATASET_URL}>Tuna Fish Detection</a>{creditMiddle}<a href={LICENSE_URL}>CC BY 4.0</a>{creditAfter}
      </p>
    </div>

    <div
      class="demo"
      data-detector
      data-state="idle"
      data-model="/models/tuna4_n_v1/tuna4_n_v1_o2m.onnx"
      data-species={JSON.stringify(t.detector.species)}
      data-strings={JSON.stringify({
        found: t.detector.found,
        none: t.detector.none,
        inference: t.detector.inference,
        onDevice: t.detector.onDevice,
        error: t.detector.error,
        badImage: t.detector.badImage,
        starting: t.detector.starting,
      })}
    >
      <MediaSlot island="detector-demo" ratio="4 / 3" class="stage">
        <canvas class="canvas" role="img" aria-label={t.detector.canvasLabel}></canvas>
        <div class="overlay">
          <div class="idle">
            <button type="button" class="btn btn-accent" data-try>{t.detector.tryIt}</button>
            <p class="mono muted">{t.detector.size}</p>
          </div>
          <div class="loading" role="status">
            <p class="mono" data-loading-label>{t.detector.loading}</p>
            <div class="bar" role="progressbar" aria-label={t.detector.loading} aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
              <span data-bar></span>
            </div>
            <p class="mono muted" data-loading-detail>&nbsp;</p>
          </div>
        </div>
        <span class="corner tl" aria-hidden="true"></span><span class="corner tr" aria-hidden="true"></span>
        <span class="corner bl" aria-hidden="true"></span><span class="corner br" aria-hidden="true"></span>
      </MediaSlot>

      <div class="toolbar">
        <span class="mono muted toolbar-label" id="detector-examples">{t.detector.examples}</span>
        <ul class="examples" aria-labelledby="detector-examples">
          {
            examples.map((e) => (
              <li>
                <button type="button" class="example mono" data-example={`/detector/examples/${e.file}.webp`} disabled>
                  {t.detector.species[e.species]}
                  {e.file.endsWith('pair') ? ' ×2' : e.file.endsWith('portrait') ? ', vertical' : ''}
                </button>
              </li>
            ))
          }
        </ul>
        <label class="btn btn-ghost choose" data-choose aria-disabled="true">
          {t.detector.choose}
          <input type="file" accept="image/*" class="visually-hidden" data-file disabled />
        </label>
      </div>
      <p class="mono status" data-status aria-live="polite">{t.detector.drop}</p>
    </div>
  </div>
</section>

<script>
  // Load the demo code only when the visitor asks for it.
  const root = document.querySelector<HTMLElement>('[data-detector]');
  root?.querySelector('[data-try]')?.addEventListener(
    'click',
    () => {
      import('../scripts/detector-demo').then((m) => m.startDetector(root));
    },
    { once: true },
  );
</script>

<style>
  .detector {
    background: var(--surface);
  }
  .grid {
    display: grid;
    gap: 32px;
    align-items: center;
  }
  .text {
    display: grid;
    gap: 20px;
  }
  .lede {
    color: var(--muted);
  }
  .privacy {
    font-weight: 500;
  }
  .credit {
    font-size: 12px;
  }
  .credit a {
    color: var(--text);
  }

  .demo {
    display: grid;
    gap: 12px;
  }
  .demo :global(.stage) {
    background: var(--bg);
    border: 1px solid var(--line);
  }
  .canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .overlay {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 24px;
    text-align: center;
  }
  .idle,
  .loading {
    display: none;
    justify-items: center;
    gap: 14px;
    max-width: 34ch;
  }
  .demo[data-state='idle'] .idle,
  .demo[data-state='loading'] .loading {
    display: grid;
  }
  .demo[data-state='ready'] .overlay,
  .demo[data-state='error'] .overlay {
    pointer-events: none;
  }
  .bar {
    width: min(280px, 60vw);
    height: 4px;
    border-radius: 2px;
    background: var(--line);
    overflow: hidden;
  }
  .bar span {
    display: block;
    width: 0;
    height: 100%;
    background: var(--accent);
  }
  .demo.is-dragging :global(.stage) {
    outline: 2px dashed var(--accent);
    outline-offset: -8px;
  }
  .corner {
    position: absolute;
    width: 24px;
    height: 24px;
    border: 0 solid var(--text);
    pointer-events: none;
  }
  .tl {
    top: 16px;
    left: 16px;
    border-width: 1.5px 0 0 1.5px;
  }
  .tr {
    top: 16px;
    right: 16px;
    border-width: 1.5px 1.5px 0 0;
  }
  .bl {
    bottom: 16px;
    left: 16px;
    border-width: 0 0 1.5px 1.5px;
  }
  .br {
    bottom: 16px;
    right: 16px;
    border-width: 0 1.5px 1.5px 0;
  }
  .demo[data-state='ready'] .corner {
    display: none;
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .toolbar-label {
    margin-right: 4px;
  }
  .examples {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .example {
    min-height: 36px;
    padding: 0 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg);
    color: var(--text);
    font-size: 12px;
    cursor: pointer;
  }
  .example:disabled {
    color: var(--muted);
    cursor: default;
  }
  .example[aria-pressed='true'] {
    border-color: var(--text);
  }
  .choose {
    min-height: 36px;
    margin-left: auto;
    padding: 0 16px;
    font-size: 12px;
  }
  .choose[aria-disabled='true'] {
    opacity: 0.55;
    pointer-events: none;
  }
  .choose:focus-within {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .status {
    min-height: 3em;
    font-size: 13px;
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: 56px;
    }
  }
  @media (max-width: 899px) {
    /* The status line is the last thing in the scene: keep it clear of the floating "Ask me" button. */
    :global(html.scenes) .detector {
      padding-bottom: 96px;
    }
  }
  :global(html.scenes) .detector .section-title {
    font-size: clamp(36px, min(5vw, 8vh), 72px);
  }
  @media (min-width: 900px) {
    /* Keep stage, toolbar and status inside one screen. */
    :global(html.scenes) .detector .demo {
      width: min(100%, calc((100svh - var(--header-h) - 200px) * 4 / 3));
      justify-self: end;
    }
  }
</style>
