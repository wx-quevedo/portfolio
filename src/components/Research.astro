---
import { ui, type Lang } from '../i18n/ui';
import { topPapers, scholarUrl } from '../data/papers';
import { buildConstellation, TOPIC_COLORS } from '../lib/constellation';
import MediaSlot from './MediaSlot.astro';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

// Static constellation (also the fallback for reduced motion, Save-Data and low-end phones):
// the 3D layout seen from above, x across and z down. Same data and links as the 3D view.
const { stars, clusters } = buildConstellation();
const W = 800;
const H = 500;
const S = 88;
const sx = (x: number) => W / 2 + x * S;
const sy = (z: number) => H / 2 + 10 + z * S;
const starsData = JSON.stringify(stars);
const topicsData = JSON.stringify({ labels: t.research.topics, colors: TOPIC_COLORS, clusters });
---

<!-- Scene mode: pinned, one most-cited paper per step; its dot lights up in the constellation. -->
<section
  id="research"
  class="scene scene-dark section research"
  data-scene="research"
  data-steps={topPapers.length}
  tabindex="-1"
  aria-labelledby="research-title"
>
  <div class="container grid">
    <div class="text">
      <h2 id="research-title" class="section-title">{t.research.title}</h2>
      <p class="lede">{t.research.text}</p>

      <div class="list-head">
        <h3 class="mono muted list-title">{t.research.top}</h3>
        <p class="mono step-count" aria-hidden="true"><span data-step-now>1</span> / {topPapers.length}</p>
      </div>
      <ol class="papers">
        {
          topPapers.map((p, i) => (
            <li data-step-item data-step={i} data-state={i === 0 ? 'active' : 'future'}>
              <a href={p.url} class="paper-title" data-paper-id={p.id}>
                {p.title}
              </a>
              <p class="mono muted">
                {p.year} · {p.citations} {t.research.citations}
              </p>
              <p class="mono muted venue">{p.venue}</p>
            </li>
          ))
        }
      </ol>

      <a class="btn btn-ghost" href={scholarUrl}>
        {t.research.scholar}
        <Icon name="arrow-up-right" />
      </a>
    </div>

    <figure class="constellation" data-constellation-figure>
      <MediaSlot island="paper-constellation" ratio="8 / 5">
        <svg class="static" viewBox={`0 0 ${W} ${H}`} role="group" aria-label={t.research.constellationLabel}>
          {
            stars.map((d) => {
              const c = clusters.find((k) => k.topic === d.topic)!;
              return <line x1={sx(c.x)} y1={sy(c.z)} x2={sx(d.x)} y2={sy(d.z)} class="edge" />;
            })
          }
          {
            clusters.map((c) => (
              <text x={sx(c.x)} y={sy(c.z) - 70} class="topic" text-anchor="middle">
                {t.research.topics[c.topic]}
              </text>
            ))
          }
          {
            stars.map((d) => (
              <a href={d.url} aria-label={`${d.title}, ${d.year}, ${d.citations} ${t.research.citations}`}>
                <circle
                  cx={sx(d.x)}
                  cy={sy(d.z)}
                  r={d.r * S}
                  fill={TOPIC_COLORS[d.topic]}
                  class:list={['dot', { 'is-current': d.step === 0 }]}
                  data-dot-step={d.step >= 0 ? d.step : undefined}
                >
                  <title>
                    {d.title} ({d.year}, {d.citations} {t.research.citations})
                  </title>
                </circle>
              </a>
            ))
          }
        </svg>
        <div
          class="three"
          data-constellation
          data-stars={starsData}
          data-topics={topicsData}
          data-citations-label={t.research.citations}
          aria-hidden="true"
          data-touch-own
          hidden
        >
        </div>
        <div class="tooltip mono" data-constellation-tip aria-hidden="true" hidden></div>
      </MediaSlot>
      <figcaption class="mono muted">
        {t.research.constellation}
        <span class="caption-3d" hidden> {t.research.constellation3d}</span>
      </figcaption>
    </figure>
  </div>
</section>

<script>
  // 3D only when it is worth it: no reduced motion, no Save-Data, not a low-end phone
  // (4 GB of memory or less, or a touch device with 4 cores or less) and WebGL2 available.
  const figure = document.querySelector<HTMLElement>('[data-constellation-figure]');
  const nav = navigator as Navigator & { connection?: { saveData?: boolean }; deviceMemory?: number };
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = nav.connection?.saveData === true;
  const coarse = matchMedia('(pointer: coarse)').matches;
  const lowEnd = (nav.deviceMemory !== undefined && nav.deviceMemory <= 4) || (coarse && (navigator.hardwareConcurrency || 8) <= 4);
  // WebGL support is probed only when Research gets close: creating a context starts the GPU
  // process, which would otherwise block the main thread during page load.
  const hasWebGL = () => {
    try {
      return !!document.createElement('canvas').getContext('webgl2');
    } catch {
      return false;
    }
  };
  if (figure && !reduce && !saveData && !lowEnd) {
    const section = document.getElementById('research')!;
    let started = false;
    // Start when Research is within half a screen. Checked on scroll and on scene steps as well,
    // because a jump straight to Research (menu link) can land inside the pin without an observer update.
    const check = () => {
      if (started) return;
      const r = section.getBoundingClientRect();
      if (r.top > innerHeight * 1.5 || r.bottom < -innerHeight * 0.5) return;
      started = true;
      io.disconnect();
      removeEventListener('scroll', check);
      if (hasWebGL()) import('../scripts/constellation').then((m) => m.initConstellation(figure));
    };
    const io = new IntersectionObserver((entries) => entries.some((e) => e.isIntersecting) && check(), { rootMargin: '50% 0px' });
    io.observe(section);
    addEventListener('scroll', check, { passive: true });
    section.addEventListener('scenestep', check);
  }
</script>

<style>
  .grid {
    display: grid;
    gap: 56px;
    align-items: start;
  }
  .text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }
  .list-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    width: 100%;
    margin-top: 16px;
  }
  .list-title {
    font-weight: 500;
  }
  .venue {
    font-size: 12px;
  }
  .papers {
    width: 100%;
    margin-bottom: 16px;
  }
  .papers li {
    display: grid;
    gap: 6px;
    padding: 18px 0;
    border-top: 1px solid var(--dark-line);
  }
  .paper-title {
    font-size: 20px;
    font-weight: 300;
    line-height: 1.35;
    text-decoration-color: rgb(237 237 232 / 0.35);
  }
  .paper-title:hover {
    text-decoration-color: currentColor;
  }
  .constellation {
    display: grid;
    gap: 16px;
  }
  .constellation :global(.media-slot) {
    background: #14171c;
    border: 1px solid var(--dark-line);
  }
  .edge {
    stroke: #343943;
    stroke-width: 1;
  }
  .dot {
    fill-opacity: 0.8;
  }
  .topic {
    fill: var(--dark-muted);
    font-family: var(--font-mono);
    font-size: 15px;
  }
  .static a:focus {
    outline: none;
  }
  .static a:focus-visible circle,
  .static a:hover circle {
    stroke: var(--dark-text);
    stroke-width: 3;
    fill-opacity: 1;
  }
  .three {
    position: absolute;
    inset: 0;
    cursor: grab;
    touch-action: none;
  }
  .three :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .three :global(.label) {
    position: absolute;
    left: 0;
    top: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--dark-muted);
    white-space: nowrap;
    pointer-events: none;
    transform: translate(-50%, -50%);
  }
  .tooltip {
    position: absolute;
    left: 0;
    top: 0;
    max-width: 260px;
    padding: 8px 10px;
    border: 1px solid var(--dark-line);
    border-radius: 4px;
    background: rgb(14 16 19 / 0.92);
    color: var(--dark-text);
    font-size: 12px;
    line-height: 1.4;
    pointer-events: none;
    z-index: 2;
  }
  .tooltip[hidden] {
    display: none;
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      gap: 64px;
    }
    .constellation {
      position: sticky;
      top: calc(var(--header-h) + 32px);
      margin-top: 24px;
    }
  }

  /* ---- Scene mode ---- */
  .dot.is-current {
    fill: var(--dark-text);
    stroke: var(--dark-focus);
    stroke-width: 3;
  }
  :global(html.scenes) .research:not(.steps-off) .grid {
    align-items: center;
    gap: clamp(24px, 4vh, 56px) 64px;
  }
  :global(html.scenes) .research:not(.steps-off) .text {
    gap: clamp(12px, 2.4vh, 24px);
  }
  :global(html.scenes) .research:not(.steps-off) .section-title {
    font-size: clamp(36px, min(5vw, 8vh), 72px);
  }
  :global(html.scenes) .research:not(.steps-off) .papers {
    display: grid;
    margin-bottom: 0;
  }
  :global(html.scenes) .research:not(.steps-off) .papers li {
    grid-area: 1 / 1;
  }
  :global(html.scenes) .research:not(.steps-off) .paper-title {
    font-size: clamp(20px, 2.2vw, 30px);
    line-height: 1.25;
  }
  :global(html.scenes) .research:not(.steps-off) .constellation {
    position: static;
    margin-top: 0;
  }
  @media (max-width: 899px) {
    /* Phones and tablets: a shorter constellation so the pinned steps fit one screen. */
    :global(html.scenes) .research:not(.steps-off) .constellation :global(.media-slot) {
      aspect-ratio: auto !important;
      height: 17svh;
    }
    :global(html.scenes) .research:not(.steps-off) .constellation {
      gap: 8px;
    }
    :global(html.scenes) .research:not(.steps-off) figcaption {
      font-size: 11px;
    }
    :global(html.scenes) .research:not(.steps-off) .grid {
      gap: 16px;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .dot {
      transition:
        fill 0.6s ease,
        stroke-width 0.6s ease;
    }
  }
</style>
