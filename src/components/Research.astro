---
import { ui, type Lang } from '../i18n/ui';
import { papers, topPapers, scholarUrl } from '../data/papers';
import MediaSlot from './MediaSlot.astro';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

// Static constellation (no JS): x by year, deterministic y, radius by citations. P9c replaces it in 3D.
const W = 800;
const H = 500;
const pad = { x: 48, top: 40, bottom: 72 };
const years = papers.map((p) => p.year);
const minYear = Math.min(...years) - 1;
const maxYear = Math.max(...years) + 1;
const topIndex = new Map(topPapers.map((p, i) => [p.id, i]));
const hash = (s: string) => [...s].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7);
const dots = [...papers]
  .sort((a, b) => a.year - b.year || b.citations - a.citations)
  .map((p) => {
    const jitter = ((hash(p.id) % 1000) / 1000 - 0.5) * 0.7;
    const x = pad.x + ((p.year - minYear + jitter) / (maxYear - minYear)) * (W - 2 * pad.x);
    const y = pad.top + ((hash(p.id + p.title) % 1000) / 1000) * (H - pad.top - pad.bottom);
    const r = 3 + Math.sqrt(p.citations) * 1.6;
    return { ...p, x, y, r, top: topIndex.has(p.id), step: topIndex.get(p.id) };
  });
const tickYears = [...new Set(years)].sort();
const xFor = (year: number) => pad.x + ((year - minYear) / (maxYear - minYear)) * (W - 2 * pad.x);
---

<!-- Scene mode: pinned, one most-cited paper per step; its dot lights up in the constellation. -->
<section
  id="research"
  class="scene scene-dark section research"
  data-scene="research"
  data-steps={topPapers.length}
  tabindex="-1"
  aria-labelledby="research-title"
>
  <div class="container grid">
    <div class="text">
      <h2 id="research-title" class="section-title">{t.research.title}</h2>
      <p class="lede">{t.research.text}</p>

      <div class="list-head">
        <h3 class="mono muted list-title">{t.research.top}</h3>
        <p class="mono step-count" aria-hidden="true"><span data-step-now>1</span> / {topPapers.length}</p>
      </div>
      <ol class="papers">
        {
          topPapers.map((p, i) => (
            <li data-step-item data-step={i} data-state={i === 0 ? 'active' : 'future'}>
              <a href={p.url} class="paper-title">
                {p.title}
              </a>
              <p class="mono muted">
                {p.year} · {p.citations} {t.research.citations}
              </p>
              <p class="mono muted venue">{p.venue}</p>
            </li>
          ))
        }
      </ol>

      <a class="btn btn-ghost" href={scholarUrl}>
        {t.research.scholar}
        <Icon name="arrow-up-right" />
      </a>
    </div>

    <figure class="constellation">
      <MediaSlot island="paper-constellation" ratio="8 / 5">
        <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={t.research.constellationLabel}>
          {
            dots.slice(1).map((d, i) => (
              <line x1={dots[i].x} y1={dots[i].y} x2={d.x} y2={d.y} class="edge" />
            ))
          }
          {
            dots.map((d) => (
              <circle
                cx={d.x}
                cy={d.y}
                r={d.r}
                class:list={['dot', { top: d.top, 'is-current': d.step === 0 }]}
                data-dot-step={d.step}
              >
                <title>
                  {d.title} ({d.year}, {d.citations} {t.research.citations})
                </title>
              </circle>
            ))
          }
          <line x1={pad.x} x2={W - pad.x} y1={H - 40} y2={H - 40} class="axis" />
          {
            tickYears.map((y) => (
              <text x={xFor(y)} y={H - 14} class="tick" text-anchor="middle">
                {y}
              </text>
            ))
          }
        </svg>
      </MediaSlot>
      <figcaption class="mono muted">{t.research.constellation}</figcaption>
    </figure>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 56px;
    align-items: start;
  }
  .text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }
  .list-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    width: 100%;
    margin-top: 16px;
  }
  .list-title {
    font-weight: 500;
  }
  .venue {
    font-size: 12px;
  }
  .papers {
    width: 100%;
    margin-bottom: 16px;
  }
  .papers li {
    display: grid;
    gap: 6px;
    padding: 18px 0;
    border-top: 1px solid var(--dark-line);
  }
  .paper-title {
    font-size: 20px;
    font-weight: 300;
    line-height: 1.35;
    text-decoration-color: rgb(237 237 232 / 0.35);
  }
  .paper-title:hover {
    text-decoration-color: currentColor;
  }
  .constellation {
    display: grid;
    gap: 16px;
  }
  .constellation :global(.media-slot) {
    background: #14171c;
    border: 1px solid var(--dark-line);
  }
  .edge {
    stroke: #3a3f48;
    stroke-width: 1;
  }
  .axis {
    stroke: var(--dark-line);
  }
  .dot {
    fill: var(--dark-muted);
    fill-opacity: 0.55;
  }
  .dot.top {
    fill: var(--dark-focus);
    fill-opacity: 1;
  }
  .tick {
    fill: var(--dark-muted);
    font-family: var(--font-mono);
    font-size: 14px;
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      gap: 64px;
    }
    .constellation {
      position: sticky;
      top: calc(var(--header-h) + 32px);
      margin-top: 24px;
    }
  }

  /* ---- Scene mode ---- */
  .dot.is-current {
    fill: var(--dark-text);
    stroke: var(--dark-focus);
    stroke-width: 3;
  }
  :global(html.scenes) .research:not(.steps-off) .grid {
    align-items: center;
    gap: clamp(24px, 4vh, 56px) 64px;
  }
  :global(html.scenes) .research:not(.steps-off) .text {
    gap: clamp(12px, 2.4vh, 24px);
  }
  :global(html.scenes) .research:not(.steps-off) .section-title {
    font-size: clamp(36px, min(5vw, 8vh), 72px);
  }
  :global(html.scenes) .research:not(.steps-off) .papers {
    display: grid;
    margin-bottom: 0;
  }
  :global(html.scenes) .research:not(.steps-off) .papers li {
    grid-area: 1 / 1;
  }
  :global(html.scenes) .research:not(.steps-off) .paper-title {
    font-size: clamp(20px, 2.2vw, 30px);
    line-height: 1.25;
  }
  :global(html.scenes) .research:not(.steps-off) .constellation {
    position: static;
    margin-top: 0;
  }
  @media (max-width: 899px) {
    /* Phones and tablets: a shorter constellation so the pinned steps fit one screen. */
    :global(html.scenes) .research:not(.steps-off) .constellation :global(.media-slot) {
      aspect-ratio: auto !important;
      height: 17svh;
    }
    :global(html.scenes) .research:not(.steps-off) .constellation {
      gap: 8px;
    }
    :global(html.scenes) .research:not(.steps-off) figcaption {
      font-size: 11px;
    }
    :global(html.scenes) .research:not(.steps-off) .grid {
      gap: 16px;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .dot {
      transition:
        fill 0.6s ease,
        stroke-width 0.6s ease;
    }
  }
</style>
