---
import { Picture } from 'astro:assets';
import { ui, type Lang } from '../i18n/ui';
import { widthsFor } from '../lib/images';
import { storyPhotos } from '../data/story';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const steps = t.story.milestones.length;
---

<!--
  Default (reduced motion, no JS): a list of milestones, each with its photo.
  Scene mode (html.scenes, see src/scripts/scenes.ts): the section is pinned and each scroll step
  crossfades to the next milestone and photo, with a very slow zoom on the current photo.
  The photos are small originals (425-968 px), so the frame never grows past 1.25x their size.
-->
<section
  id="story"
  class="scene scene-dark story section"
  data-scene="story"
  data-steps={steps}
  tabindex="-1"
  aria-labelledby="story-title"
>
  <div class="container inner">
    <div class="head">
      <h2 id="story-title" class="section-title">{t.story.title}</h2>
      <p class="mono muted note">{t.story.note}</p>
      <p class="mono step-count" aria-hidden="true"><span data-step-now>1</span> / {steps}</p>
    </div>

    <ol class="milestones">
      {
        t.story.milestones.map((m, i) => {
          const photo = storyPhotos[i];
          return (
            <li data-step-item data-step={i} data-state={i === 0 ? 'active' : 'future'}>
              <div class="text">
                <span class="mono year">{m.year}</span>
                <p>{m.text}</p>
              </div>
              <figure class="photo">
                <div
                  class="frame"
                  style={`--w: ${photo.image.width}px; --ratio: ${(photo.image.width / photo.image.height).toFixed(4)}`}
                >
                  <Picture
                    src={photo.image}
                    alt={photo.alt[lang]}
                    formats={['avif', 'webp']}
                    fallbackFormat="jpg"
                    widths={widthsFor(photo.image, [480, 800, 1200])}
                    sizes="(min-width: 900px) 640px, calc(100vw - 64px)"
                  />
                </div>
                <figcaption class="mono muted">{photo.caption[lang]}</figcaption>
              </figure>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>

<style>
  /* ---- List mode ---- */
  .head {
    display: grid;
    gap: 24px;
    margin-bottom: clamp(40px, 5vw, 64px);
  }
  .note {
    max-width: 52ch;
  }
  .milestones {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 48px 32px;
  }
  .milestones li {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .photo {
    order: -1;
    display: grid;
    gap: 10px;
  }
  .frame {
    overflow: hidden;
    border-radius: var(--radius);
    background: #14171c;
  }
  .frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  figcaption {
    font-size: 12px;
  }
  .year {
    display: block;
    margin-bottom: 6px;
    color: var(--dark-muted);
    font-weight: 500;
  }
  .text p {
    font-size: 17px;
    font-weight: 300;
    line-height: 1.45;
  }

  @media (min-width: 640px) {
    .milestones {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 900px) {
    .head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: end;
    }
    .milestones {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* ---- Scene mode ---- */
  :global(html.scenes) .story:not(.steps-off) .inner {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }
  :global(html.scenes) .story:not(.steps-off) .head {
    margin-bottom: clamp(16px, 3vh, 40px);
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
  }
  :global(html.scenes) .story:not(.steps-off) .section-title {
    font-size: clamp(36px, min(5vw, 8vh), 72px);
  }
  :global(html.scenes) .story:not(.steps-off) .note {
    grid-column: 1 / -1;
    grid-row: 2;
  }
  :global(html.scenes) .story:not(.steps-off) .milestones {
    position: relative;
    flex: 1;
    min-height: 0;
    display: block;
    container-type: size;
  }
  :global(html.scenes) .story:not(.steps-off) .milestones li {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto auto;
    align-content: center;
    gap: 20px;
  }
  :global(html.scenes) .story:not(.steps-off) .photo {
    order: 0;
    justify-items: center;
  }
  :global(html.scenes) .story:not(.steps-off) .frame {
    /* Never wider than the column, never past 1.25x the original pixels, never taller than the stage. */
    width: min(100%, calc(var(--w) * 1.25), calc((100cqh - 190px) * var(--ratio)));
    aspect-ratio: var(--ratio);
  }
  :global(html.scenes) .story:not(.steps-off) .frame :global(img) {
    aspect-ratio: auto;
    transform: scale(1);
    /* Reset the zoom only after the photo has faded out. */
    transition: transform 0s linear 0.8s;
  }
  :global(html.scenes) .story:not(.steps-off) li[data-state='active'] .frame :global(img) {
    transform: scale(1.06);
    transition: transform 9s linear;
  }
  :global(html.scenes) .story:not(.steps-off) .text p {
    font-size: clamp(19px, 2vw, 28px);
    line-height: 1.35;
    max-width: 30ch;
  }

  @media (min-width: 900px) {
    :global(html.scenes) .story:not(.steps-off) .note {
      grid-column: auto;
      grid-row: auto;
    }
    :global(html.scenes) .story:not(.steps-off) .head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
    }
    :global(html.scenes) .story:not(.steps-off) .milestones li {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-rows: auto;
      align-items: center;
      gap: 56px;
    }
    :global(html.scenes) .story:not(.steps-off) .frame {
      width: min(100%, calc(var(--w) * 1.25), calc((100cqh - 40px) * var(--ratio)));
    }
    :global(html.scenes) .story:not(.steps-off) .year {
      font-size: 15px;
      margin-bottom: 12px;
    }
  }
</style>
