---
import { Picture } from 'astro:assets';
import { ui, type Lang } from '../i18n/ui';
import Icon from './Icon.astro';
import portrait from '../assets/washington-quevedo.jpg';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container grid">
    <div class="text">
      <p class="mono kicker muted">{t.hero.kicker}</p>
      <h1 id="hero-title" class="name">
        <span>Washington</span>
        <span>X. Quevedo</span>
      </h1>
      <p class="lead">{t.hero.lead}</p>
      <div class="cta">
        <a class="btn btn-accent" href="#story">{t.hero.watch}<Icon name="arrow-down" /></a>
        <a class="btn btn-ghost" href="#work">{t.hero.skip}</a>
      </div>
    </div>

    <!-- 4:5 portrait shown in black and white; first screen, so not lazy. -->
    <div class="portrait">
      <Picture
        src={portrait}
        alt={t.hero.portraitAlt}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        widths={[240, 360, 480, 720, 840]}
        sizes="(min-width: 900px) 420px, 132px"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: calc(var(--header-h) + clamp(48px, 8vw, 104px));
    padding-bottom: clamp(64px, 8vw, 112px);
  }
  .grid {
    display: grid;
    gap: 28px;
    align-items: end;
  }
  .kicker {
    margin-bottom: clamp(24px, 3vw, 40px);
  }
  .name {
    font-size: clamp(52px, 10.4vw, 148px);
    font-weight: 300;
    line-height: 0.95;
    letter-spacing: -0.035em;
  }
  .name span {
    display: block;
  }
  .lead {
    margin-top: clamp(28px, 3.5vw, 48px);
    max-width: 34ch;
    font-size: clamp(20px, 2vw, 26px);
    font-weight: 300;
    line-height: 1.4;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .portrait {
    order: -1;
    width: 132px;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
  }
  .portrait :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.04);
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: minmax(0, 1fr) minmax(280px, 0.42fr);
      gap: 64px;
    }
    .portrait {
      order: 0;
      justify-self: end;
      width: 100%;
      max-width: 420px;
    }
  }

  /* ---- Scene mode: hero and key numbers share the first screen ---- */
  :global(html.scenes) .hero {
    flex: 1;
    display: flex;
    align-items: center;
    padding-block: 0 clamp(16px, 3vh, 40px);
  }
  :global(html.scenes) .name {
    font-size: clamp(48px, min(10.4vw, 13svh), 148px);
  }
  :global(html.scenes) .kicker {
    margin-bottom: clamp(16px, 2.5vh, 40px);
  }
  :global(html.scenes) .lead {
    margin-top: clamp(16px, 3vh, 48px);
  }
  :global(html.scenes) .cta {
    margin-top: clamp(20px, 3.5vh, 36px);
  }
  @media (min-width: 900px) {
    :global(html.scenes) .portrait {
      /* Keep the portrait inside the screen next to the key numbers. */
      width: min(420px, calc((100svh - var(--header-h) - 260px) * 0.8));
    }
  }
</style>
