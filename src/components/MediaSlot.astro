---
/**
 * Fixed-ratio frame that reserves space for a future island.
 * The static fallback goes in the default slot; P9b/P9c replace it with a client island
 * (for example <StoryFilm client:visible />) keyed by `island`.
 *   story-film           P9b  scroll-driven video (GSAP + Lenis)
 *   detector-demo        P9c  in-browser detector (ONNX Runtime Web)
 *   paper-constellation  P9c  3D paper constellation (Three.js / React Three Fiber)
 */
interface Props {
  island: 'story-film' | 'detector-demo' | 'paper-constellation';
  ratio: string;
  class?: string;
}
const { island, ratio, class: className } = Astro.props;
---

<div class:list={['media-slot', className]} data-island={island} style={`aspect-ratio: ${ratio}`}>
  <slot />
</div>

<style>
  .media-slot {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius);
  }
  .media-slot > :global(picture),
  .media-slot > :global(img),
  .media-slot > :global(svg) {
    width: 100%;
    height: 100%;
  }
  .media-slot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
